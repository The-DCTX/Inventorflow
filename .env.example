# Copiez ce fichier en .env et adaptez les valeurs avant le premier démarrage.
# Port HTTP exposé sur la machine hôte
APP_PORT=8080

# Base de données (le conteneur MariaDB est créé avec ces identifiants)
DB_NAME=inventorflow
DB_USER=inventorflow
DB_PASS=change-me-db
DB_ROOT_PASS=change-me-root

# Compte administrateur de l'application (login : admin)
ADMIN_PASS=AdminTest2024!

# Mot de passe de la page de restauration de secours (/recovery.php).
# Laissez vide pour ne pas l'activer au démarrage.
RECOVERY_PASS=
